# demo keeps the existing local prototype at /. connected opens the authenticated portal.
CAMPUS_MODE=demo
# Use localhost for local web callbacks; use the exact HTTPS domain in Azure.
AUTH_URL=http://localhost:3000
# Generate a unique secret outside Git (e.g. openssl rand -base64 48).
AUTH_SECRET=
CAMPUS_API_URL=http://127.0.0.1:8000
# Campus user identity provider; these are NOT the GitHub deployment credentials.
CAMPUS_OIDC_ISSUER=
CAMPUS_OIDC_CLIENT_ID=
CAMPUS_OIDC_CLIENT_SECRET=
# Include openid plus the provider's scope for the Campus API audience.
CAMPUS_OIDC_SCOPE=

# Use an empty value if the provider does not support select_account.
CAMPUS_OIDC_PROMPT=select_account
