APP_ENV=development
DATABASE_URL=sqlite:///.data/campus.db
CORS_ORIGINS=http://localhost:3000
# All three fields are required to enable authenticated endpoints.
# Configure the provider for Campus users, not the GitHub deployment identity.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required in production: claims in delegated API access tokens.
OIDC_REQUIRED_SCOPE=
# Comma-separated authorized client IDs (azp/appid), not deployment identities.
OIDC_ALLOWED_CLIENTS=
# Private routes require this signed Entra context. Bind it to an enforced MFA
# Conditional Access policy before enabling private documents in production.
OIDC_PRIVATE_AUTH_CONTEXT=
# Private document API stays disabled until Azure/network/scanner validation passes.
DOCUMENTS_ENABLED=false
BLOB_ACCOUNT_URL=
# Managed identity CLIENT IDs, not principal/object IDs. No CLI/key fallback.
BLOB_UPLOAD_CLIENT_ID=
BLOB_READER_CLIENT_ID=
